# Builder backend configuration (Node.js server)
HOST=127.0.0.1
PORT=8787
CORE_API_URL=https://api.4ndev.dev

# Comma-separated exact browser origins permitted to call this backend.
# Keep localhost for development; replace with the actual Builder domain in deployment.
BUILDER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vite browser app configuration. Set this to the deployed Builder backend URL
# for the browser app; leave blank until a backend URL has been configured.
VITE_BUILDER_API_URL=

# Persistent local/single-instance JSON store. Use a private persistent volume for this file.
BUILDER_DATA_FILE=./data/builder-store.json

# Required to encrypt users' Core API keys at rest. Generate with: openssl rand -base64 32
# Keep this secret outside Git; changing it makes saved keys unreadable.
BUILDER_ENCRYPTION_KEY=

# In production, use HTTPS and set the exact frontend origin above.
# Do not put Core API keys in VITE_* variables or browser storage.
